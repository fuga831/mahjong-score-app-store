// firestore.rules — マルチプレイヤー(フレンド・卓・成績共有)機能のセキュリティルール
//
// 🚨🚨🚨 このファイルを編集したら、その都度あなた自身の手で
// Firebaseへ再デプロイしないと一切反映されません 🚨🚨🚨
//   firebase deploy --only firestore:rules
// (または Firebase Console > Firestore Database > ルール タブに
// このファイルの中身を貼り付けて「公開」)。CI/CDでの自動デプロイは
// 組んでいないため、コミットしただけでは実機・TestFlightビルドの
// 挙動は一切変わりません。
//
// ⚠️ このサンドボックス(Claude Codeの実行環境)自体にはFirebase CLIで
// 実際にデプロイできるログイン済みアカウント・Firebaseプロジェクトへの
// 認証情報が無く(.firebaserc・サービスアカウント・CIトークンいずれも
// 存在しない)、実際にデプロイされているルールの内容を直接確認する
// 手段がありません。以下はアプリのクライアント側コード
// (www/index.html内のCloudSyncオブジェクト)が実際に発行するFirestore
// 呼び出しの形に合わせて書いたルールですが、`firebase emulators:start`
// 等で必ず実地検証してから本番反映してください。
//
// 🔍「Missing or insufficient permissions」で操作が失敗する場合の
// 切り分け手順(上から順に確認):
//   1. このファイルの内容と、実際にFirebase側へデプロイされている内容が
//      一致しているか(`firebase firestore:rules get` やFirebase Console
//      のルールタブで確認。上記の理由によりこの一致確認はご自身の手元で
//      行う必要がある)
//   2. 一致しているのに失敗する場合、サインインセッション側の問題
//      (IDトークンが古い・forceRefreshしてもFirestore側の内部キャッシュに
//      反映されていない、等の既知の類の不具合)である可能性がある。
//      www/index.html の CloudSync._forceRefreshIdToken() で対策済みだが、
//      それでも解決しない場合は一度サインアウトしてから同じアカウントで
//      再度ログインし直すことで解消するケースがある
//   3. どちらでもない場合のみ、以下のルール条件式自体
//      (request.auth.uidの型・ドキュメントIDの形式など)を再検証すること
//
// データモデル:
//   usernames/{normalizedUsername}      -> { uid }
//   users/{uid}                          -> { username, matchCount, pushToken, isPremium, ... }
//   users/{uid}/friends/{friendUid}      -> { uid, username, addedAt }
//   users/{uid}/matchHistory/{matchId}   -> { ...対局データ, participantUids, recordedBy }
//   rooms/{roomId}                       -> { hostUid, participants, participantUids, status, hanchans, chips, ... }
//   claimTokens/{token}                  -> { matchId, playerSlot, hostUid, token, createdAt,
//                                              expiresAt, used, usedBy, matchData }
//                                          ゲストプレイヤーへの結果受け取りリンク(Universal Links)用。
//                                          トークン文字列自体が推測困難な乱数(capability URL方式)である
//                                          ことを前提に、get(単一ドキュメント参照)ベースの検証で完結させている。

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- usernames: 検索・招待用の一意な識別子 ----
    // 「予約なし」の方針どおり、旧ユーザーネームは削除と同時に即座に誰でも
    // 再取得できるようになる(claimUsername側でdelete→createを行う)。
    match /usernames/{name} {
      // 検索(searchUsername)のため、サインインしていれば誰でも読める。
      allow get: if isSignedIn();
      // 先着順: まだ誰も使っていない名前を、自分のuidを紐付けてのみ作成できる。
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      // 既存の割り当てを別のuidに書き換えることはできない(乗っ取り防止)。
      allow update: if false;
      // 自分が保有しているユーザーネームだけ削除(=解放)できる。
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- users/{uid}: プロフィール・無料枠カウンタ ----
    match /users/{uid} {
      // username検索結果の表示(searchUsername)のため、サインインしていれば
      // 誰でも読める設計にしている。pushTokenなど本来公開したくないフィールドも
      // 同じドキュメントに同居させているため、本番では「公開プロフィール用の
      // サブドキュメント」に分離することを検討すること(このスキャフォールドでは
      // シンプルさを優先し分離していない)。
      allow get: if isSignedIn();
      allow list: if false; // 一覧列挙は許可しない(検索はusernames経由のみ)

      // 本人のみ書き込み可能。matchCountは「増える方向にしか動かせない」
      // ようにして、無料枠のカウントを自分で巻き戻せないようにする。
      // (isPremiumはこのドキュメントでは扱わない。課金状態はストアの購入検証を
      // 正として端末側で保持する設計のため、本番でサーバー側判定も行いたい場合は
      // 別途Cloud Functions + Play/StoreKitのサーバー間検証と組み合わせること。)
      allow create: if isSelf(uid);
      allow update: if isSelf(uid)
        && (!('matchCount' in request.resource.data)
            || !('matchCount' in resource.data)
            || request.resource.data.matchCount >= resource.data.matchCount);
      // アカウント削除機能(CloudSync.deleteAccount)のため、本人による削除を許可する。
      // 「delete→create で matchCount を巻き戻せてしまう」という抜け道は理論上あるが、
      // 端末を初期化して新規の匿名アカウントを作られた場合と実質的に同じであり、
      // これによって新たに生まれる抜け道ではないため許容する。
      allow delete: if isSelf(uid);

      // ---- users/{uid}/friends/{friendUid} ----
      match /friends/{friendUid} {
        // フレンド一覧は本人のみ読める。
        allow read: if isSelf(uid);
        // 自分自身のfriendsサブコレクションへは自分だけが書き込める
        // (addFriend/removeFriendは常に「自分の」friendsに対して呼ばれる設計)。
        allow write: if isSelf(uid);
      }

      // ---- users/{uid}/matchHistory/{matchId} ----
      match /matchHistory/{matchId} {
        // 対局記録は本人のみ閲覧できる(他人のmatchHistoryは見えない)。
        allow read: if isSelf(uid);

        // 本人による確定保存(自分のarchiveMatchFanoutの自分向け書き込み)。
        allow create: if isSelf(uid);

        // 代表入力者からの自動配信(ファンアウト)書き込み: 自分のuidが
        // rooms/{roomId}の参加者リストに含まれている場合に限り、そのrooms
        // ドキュメントのhostUidからの書き込みを自分のmatchHistoryへ許可する。
        // Firestoreルールはコレクション全体を検索するクエリ的なget()ができず
        // ドキュメントパスを直接指定する必要があるため、書き込むデータ自体に
        // roomIdを含めてもらい(archiveCurrentMatch側でentry.roomIdを設定済み)、
        // それをget()でrooms/{roomId}ドキュメントとして検証する形にしている。
        allow create: if isSignedIn()
          && request.resource.data.recordedBy == request.auth.uid
          && uid in request.resource.data.participantUids
          && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.hostUid == request.auth.uid
          && uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.participantUids
          // 無料枠(FREE_MATCH_LIMIT=3)を超える場合は、対象ユーザーがisPremiumで
          // ない限り拒否する。matchCountは上のusers/{uid}更新ルールで検証済みの
          // 値をそのまま信頼する設計。
          && (get(/databases/$(database)/documents/users/$(uid)).data.matchCount < 3
              || get(/databases/$(database)/documents/users/$(uid)).data.isPremium == true);

        // ゲストプレイヤーへの結果受け取りリンク(claimTokens)経由での取り込み。
        // 「自分(uid)がこのmatchIdを受け取る権利がある」ことを、対応する
        // claimTokensドキュメントが有効(未使用・期限内・matchId一致)かどうかの
        // get()だけで検証する。書き込むデータ自体にclaimTokenフィールドとして
        // トークン文字列を含めてもらう必要がある(CloudSync.claimMatchToken参照)。
        // このcreateとclaimTokens側のupdate(使用済み化)は別々の書き込みで
        // アトミックではないが、二重取り込みが起きても「同じ内容が重複するだけ」
        // でありmatchHistory自体は不変(update:false)のため実害は無い。
        allow create: if isSelf(uid)
          && request.resource.data.claimToken is string
          && get(/databases/$(database)/documents/claimTokens/$(request.resource.data.claimToken)).data.matchId == matchId
          && get(/databases/$(database)/documents/claimTokens/$(request.resource.data.claimToken)).data.used == false
          && get(/databases/$(database)/documents/claimTokens/$(request.resource.data.claimToken)).data.expiresAt > request.time.toMillis();

        // 確定済みの記録は変更不可(過去の記録を後から書き換えられないように)。
        allow update: if false;
        // 自分の記録は自分で削除できる(対局履歴モーダルの削除機能)。
        allow delete: if isSelf(uid);
      }
    }

    // ---- claimTokens/{token}: ゲストプレイヤーへの結果受け取りリンク ----
    // トークン文字列(ドキュメントID自体)が長い乱数で推測困難であることを
    // 前提にした、capability URL方式のアクセス制御。受け取る側は「トークンを
    // 知っている(URLを開いた)」時点ではまだhostUidでもusedByでもないため、
    // 単純なisSelf()判定では読めない。そのため get は署名済みユーザーなら
    // 誰でも許可し(list:falseで一覧列挙は禁止、ドキュメントIDを知らない限り
    // 到達できない)、代わりに更新(使用済み化)側で厳しく検証する。
    match /claimTokens/{token} {
      allow get: if isSignedIn();
      allow list: if false;
      // 発行(「リンクを送る」): 自分のuidをhostUidとして、未使用状態でのみ作成できる。
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.used == false
        && request.resource.data.usedBy == null;
      // 受け取り確定: 未使用・期限内のトークンだけを、usedとusedBy(自分)以外
      // 変更せずに更新できる(他のフィールドの改ざん・巻き戻しを防ぐ)。
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.playerSlot == resource.data.playerSlot
        && request.resource.data.token == resource.data.token
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.matchData == resource.data.matchData;
      allow delete: if false;
    }

    // ---- rooms/{roomId}: 進行中の卓 ----
    match /rooms/{roomId} {
      // 参加者(ホスト・閲覧者とも)のみ読める。
      allow get: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      // checkActiveRoomInviteの「自分が参加者に含まれるactiveな卓を探す」
      // クエリのために、参加者であればlistも許可する(Firestoreのlistルールは
      // クエリ結果の各ドキュメントに対して評価されるため、
      // 実質的にparticipantUids array-containsの絞り込みと組み合わせて安全)。
      allow list: if isSignedIn();
      // 卓の作成はhostUidが自分自身の場合のみ。
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      // 更新はホストのみ(代表入力者は1卓につき1人、という設計を反映)。
      allow update: if isSignedIn() && resource.data.hostUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
