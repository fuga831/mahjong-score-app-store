require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseFirestore', :path => '../../node_modules/@capacitor-firebase/firestore'
  pod 'CapacitorFirebaseMessaging', :path => '../../node_modules/@capacitor-firebase/messaging'
  pod 'CordovaPlugins', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # ⚠️ GoogleSignInをここに直接 `pod` 宣言しない・OTHER_SWIFT_FLAGSで
  # -DRGCFA_INCLUDE_GOOGLE をpost_installから手動注入しない こと。
  # それだけではCapacitorFirebaseAuthenticationターゲット自身が
  # GoogleSignInモジュールに依存する形にならず、
  # 「Unable to resolve module dependency: 'GoogleSignIn'」でビルドが
  # 失敗する(OTHER_SWIFT_FLAGSはあくまでコンパイルフラグであり、
  # ポッド間の依存関係グラフには影響しないため)。
  #
  # 正しい解決策は、CapacitorFirebaseAuthenticationのGoogleサブスペック
  # (`CapacitorFirebaseAuthentication/Google`)を使うこと。このサブスペックの
  # podspecが `dependency 'GoogleSignIn', '7.1.0'` と
  # `xcconfig 'OTHER_SWIFT_FLAGS' => '-DRGCFA_INCLUDE_GOOGLE'` の両方を
  # 一体で宣言しているため、これだけで依存関係グラフ・フラグの両方が
  # 正しく解決される。
  #
  # ただし上の `capacitor_pods`(defブロック)は `npx cap sync ios` を
  # 実行するたびに @capacitor/cliが自動生成し直すため、
  # `pod 'CapacitorFirebaseAuthentication/Google'` のようにサブスペックを
  # 直接ここに書いてもcap syncのたびに消えてしまう
  # (@capacitor/cli/dist/ios/update.jsのupdatePodfile()が
  # `pod '<name>', :path => '<path>'` という素の形で毎回書き直すため)。
  # そのため `npm run sync:ios` / `npm run sync`(生の `npx cap sync` では
  # なくこちら)経由でcap syncを実行し、直後に
  # scripts/patch-podfile-google-signin.js がこの行を自動的に
  # `CapacitorFirebaseAuthentication/Google` へ書き換える運用にしている。
  # (Codemagic側のビルドスクリプトも同様に `npm run sync:ios` を使う)
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
