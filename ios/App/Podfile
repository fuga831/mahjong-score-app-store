require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseFirestore', :path => '../../node_modules/@capacitor-firebase/firestore'
  pod 'CapacitorFirebaseMessaging', :path => '../../node_modules/@capacitor-firebase/messaging'
  pod 'CordovaPlugins', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # CapacitorFirebaseAuthenticationのGoogleサブスペックを有効にするために必要
  # (下のpost_installと対で使う。理由はそちらのコメント参照)。
  pod 'GoogleSignIn', '7.1.0'
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # ⚠️ `capacitor_pods`(上のdefブロック)は `npx cap sync ios` を実行するたびに
  # @capacitor/cliが自動生成し直すため、`pod 'CapacitorFirebaseAuthentication/Google'`
  # のようにサブスペックを直接指定してもcap syncのたびに消えてしまう
  # (@capacitor/cli/dist/ios/update.jsのupdatePodfile()が
  # `pod '<name>', :path => '<path>'` という素の形で毎回書き直すため)。
  # そのため、Googleサブスペックが有効にするのと同じ効果を、cap syncで
  # 書き換えられないこのpost_installブロックとtarget内の追加pod宣言
  # (上のGoogleSignIn行)で手動的に再現している:
  #   1. 上でGoogleSignInポッドを明示的に追加する
  #   2. ここでCapacitorFirebaseAuthenticationターゲットに、Googleサブスペックの
  #      xcconfigが本来設定するのと同じ -DRGCFA_INCLUDE_GOOGLE フラグを立てる
  #      (GoogleAuthProviderHandler.swiftはこのフラグで実装を切り替えている)
  # これが無いと、Googleサインインのボタンを押しても何も起きない
  # (ビルド自体は通ってしまうため、この不具合は気づきにくい)。
  installer.pods_project.targets.each do |target|
    if target.name == 'CapacitorFirebaseAuthentication'
      target.build_configurations.each do |config|
        flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
        unless flags.include?('-DRGCFA_INCLUDE_GOOGLE')
          config.build_settings['OTHER_SWIFT_FLAGS'] = "#{flags} -DRGCFA_INCLUDE_GOOGLE"
        end
      end
    end
  end
end
