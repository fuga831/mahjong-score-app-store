require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseFirestore', :path => '../../node_modules/@capacitor-firebase/firestore'
  pod 'CapacitorFirebaseMessaging', :path => '../../node_modules/@capacitor-firebase/messaging'
  pod 'CordovaPlugins', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # ⚠️ GoogleSignInをここに直接 `pod` 宣言しない・OTHER_SWIFT_FLAGSで
  # -DRGCFA_INCLUDE_GOOGLE をpost_installから手動注入しない こと。
  # それだけではCapacitorFirebaseAuthenticationターゲット自身が
  # GoogleSignInモジュールに依存する形にならず、
  # 「Unable to resolve module dependency: 'GoogleSignIn'」でビルドが
  # 失敗する(OTHER_SWIFT_FLAGSはあくまでコンパイルフラグであり、
  # ポッド間の依存関係グラフには影響しないため)。
  #
  # 正しい解決策は、CapacitorFirebaseAuthenticationのGoogleサブスペック
  # (`CapacitorFirebaseAuthentication/Google`)を使うこと。このサブスペックの
  # podspecが `dependency 'GoogleSignIn', '7.1.0'` と
  # `xcconfig 'OTHER_SWIFT_FLAGS' => '-DRGCFA_INCLUDE_GOOGLE'` の両方を
  # 一体で宣言しているため、これだけで依存関係グラフ・フラグの両方が
  # 正しく解決される。
  #
  # 以前は、上の `capacitor_pods`(defブロック)が `npx cap sync ios` の
  # たびに自動生成し直される(@capacitor/cliのupdatePodfile()が
  # `pod '<name>', :path => '<path>'` という素の形で毎回書き直す)ことを
  # 逆手に取り、cap sync直後にこの行を後からスクリプトで
  # `CapacitorFirebaseAuthentication/Google` に書き換える運用にしていた。
  # しかし実機検証の結果、明示的なサブスペック指定(`/Google`)で
  # 消費すると、ビルド自体は成功するのにFirebaseAuthenticationプラグイン
  # クラスがランタイムに一切登録されない(window.Capacitor.Plugins.
  # FirebaseAuthenticationがundefinedになる)問題が確認された
  # (同じ仕組みで動くFirebaseMessaging/FirebaseFirestoreは正常に登録
  # されるため、Capacitor/CocoaPods全体の問題ではなくこの明示サブスペック
  # 指定に固有の問題と判断)。
  #
  # そのため現在は、patches/@capacitor-firebase+authentication+*.patch
  # (patch-package、`npm install`のpostinstallで自動適用)で
  # CapacitorFirebaseAuthentication.podspec自体の `default_subspec` を
  # 'Lite' から 'Google' に書き換える方式に変更した。これにより、
  # `capacitor_pods`が生成する素の `pod 'CapacitorFirebaseAuthentication'`
  # (サブスペック指定なし)のままでもGoogleサブスペックがデフォルトで
  # 有効になり、FirebaseMessaging/FirebaseFirestoreと全く同じ「サブスペック
  # 指定なしの素のpod」という消費のされ方に揃う。Podfileを書き換える
  # スクリプトは不要になったため廃止した(scripts/以下には残っていない)。
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Xcode 15以降の「User Script Sandboxing」は、Podの各ターゲットに含まれる
  # スクリプトフェーズ(「Create Symlinks to Header Folders」等)のファイル
  # システムアクセスを制限する。宣言したoutputの外にアクセスするスクリプトが
  # あると、アーカイブビルドが具体的なエラー行を残さないまま
  # "Failed to archive App.xcworkspace"(exit code 65)で落ちることがある
  # (Codemagicでの実際の失敗で確認)。CocoaPodsが生成する各Podのターゲットは
  # このサンドボックス対応が未整備なものが多いため、全ターゲットで明示的に
  # 無効化する。
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
end
